# Copia este archivo como backend/.env y completa los valores.
SECRET_KEY=replace-with-your-secret-key

ALLOWED_HOSTS=localhost,127.0.0.1

# Base PostgreSQL central (la misma del sistema administrativo).
# Forma principal: postgres://usuario:contraseña@servidor:puerto/base
DATABASE_URL=
# Alternativa si no se usa DATABASE_URL:
# DB_NAME=your_database
# DB_USER=your_user
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_PORT=5432

# Base MongoDB de ORIGEN para la migración. Usar un usuario de solo lectura.
MONGO_URI=
MONGO_DB=

# Archivos del LIMS (app `lab`): Cloudinary. Formato que da Cloudinary:
#   cloudinary://<api_key>:<api_secret>@<cloud_name>
# Si se deja vacío, los archivos del laboratorio se guardan en backend/media/lab/ para poder
# trabajar en local. PENDIENTE: pedir la cuenta a la empresa (ver PENDIENTES.md).
CLOUDINARY_URL=
# Opcional: carpeta raíz dentro de Cloudinary, para no mezclar con otros sistemas.
CLOUDINARY_PREFIX=

# Lectura de hojas. Las fotos son datos de clientes: carpeta fuera del repositorio.
LECTURA_MEDIA_ROOT=
# manual | simulado (los servicios reales se agregan después de la prueba comparativa)
LECTURA_PROVEEDOR=manual
LECTURA_SIMULADO_DIR=
LECTURA_UMBRAL_CONFIANZA=0.90
LECTURA_TAMANO_MAXIMO_MB=20
